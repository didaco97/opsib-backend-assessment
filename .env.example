# PostgreSQL in production; SQLite (sqlite:///./opsib.db) works for a zero-setup local run.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opsib
# Frozen scenario clock - all deadline/shift logic uses this, never the machine clock.
EVAL_TIME=2026-10-16T15:00:00+05:30
FIXTURES_DIR=fixtures
# Availability samples older than this at EVAL_TIME are stale for routing.
AVAILABILITY_FRESHNESS_MINUTES=60
TASK_DUE_HOURS=24
SHORTFALL_TOLERANCE=0
